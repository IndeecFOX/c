#!/bin/bash

#Чтобы удобнее красить текст
plain='\033[0m'
red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
blue='\033[0;34m'
pink='\033[0;35m'
cyan='\033[0;36m'

echo "Установка tcpdump для прослушивания запросов доменов"
opkg update && opkg install tcpdump
echo "Пробуем остановить процесс если существует"
/opt/etc/init.d/S99c2 stop
echo "Скачивание 3 файлов и выдача прав. Если будут ошибки - выведется сообщение"

# Скачивает свежую версию skip_wl.txt и ОБЪЕДИНЯЕТ её с уже имеющимся
TARGET="/opt/zator/extra_strats/skip_wl.txt"
TMP_NEW="/tmp/skip_wl_new.txt"
TMP_MERGED="/tmp/skip_wl_merged.txt"
if ! curl --connect-timeout 9 -f -L -o "$TMP_NEW" https://raw.githubusercontent.com/IndeecFOX/c/2/skip_wl.txt; then
    echo "Ошибка скачивания skip_wl.txt - оставляем текущий файл без изменений"
    rm -f "$TMP_NEW"
    exit 1
fi
{
    [ -f "$TARGET" ] && cat "$TARGET"
    cat "$TMP_NEW"
} | sort -u > "$TMP_MERGED"
before=0
[ -f "$TARGET" ] && before=$(wc -l < "$TARGET")
after=$(wc -l < "$TMP_MERGED")
mv "$TMP_MERGED" "$TARGET"
rm -f "$TMP_NEW" 
echo "Объединено: было ${before} строк, стало ${after} строк (после дедупликации)"

curl --connect-timeout 9 -L -o /opt/zator/extra_strats/c2.sh https://raw.githubusercontent.com/IndeecFOX/c/2/c2.sh || echo "c2.sh не скачался?"
chmod +x /opt/zator/extra_strats/c2.sh
curl --connect-timeout 9 -L -o /opt/etc/init.d/S99c2 https://raw.githubusercontent.com/IndeecFOX/c/2/S99c2 || echo "S99c2 не скачался?"
chmod +x /opt/etc/init.d/S99c2
read -r -p $'\033[0;32mВыполнить нормализацию листов? Рекомендуется единожды если листы не трогались руками. Не знаете? Делайте.(enter - Да. 666 - нет): \033[0m' answer_norm
if [ "$answer_norm" = "666" ]; then
    echo "Пропущено (/opt/zator/extra_strats/c2.sh normalize)"
else
    /opt/zator/extra_strats/c2.sh normalize
fi
read -r -p $'\033[0;32mИзменить конфиг сита в nano редакторе?(enter - нет. 666 - да): \033[0m' answer
if [ "$answer" = "666" ]; then
    nano /opt/zator/extra_strats/c2.sh
fi
echo "Продолжаем работу скрипта..."
/opt/etc/init.d/S99c2 start
echo "Процесс завершён. Вызваем статус службы"
/opt/etc/init.d/S99c2 status
